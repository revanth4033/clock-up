# ---------------------------------------------------------------------------
# ClockUp environment variables (see TADG §9)
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. NEVER expose a secret key to the client.
# ---------------------------------------------------------------------------

# Supabase project URL + publishable (browser-safe) key (`sb_publishable_…`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (`sb_secret_…`; legacy name: service_role). SERVER ONLY.
# Never prefix with NEXT_PUBLIC_. Not required for MVP auth.
SUPABASE_SECRET_KEY=

# Google Maps key — reserved for future geofence map display (not used in MVP).
GOOGLE_MAPS_KEY=

# Feature flags -------------------------------------------------------------
# Time Credits earning (Phase 3). "true" makes a completed day also earn Time
# Credits (1 per minute past the 9h goal), in the same atomic transaction as
# points. Unset / anything else = off = exactly v1.0 behaviour (points only).
# Redemption is a separate, later phase. Safe to toggle and roll back.
ENABLE_TIME_CREDITS=false

# Time Credit redemption (Phase 4B+). "true" exposes the redemption service
# endpoints (create/adjust/cancel/read holds). It does NOT by itself consume
# credits or change attendance/points/clock-out. Off = exactly today's behaviour.
ENABLE_CREDIT_REDEMPTION=false
