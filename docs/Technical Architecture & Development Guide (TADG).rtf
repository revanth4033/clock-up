\f0\b\fs32 \cf0 26. Claude Code Rules\
\pard\pardeftab560\slleading20\partightenfactor0

\f1\b0\fs26 \cf0 Every prompt sent to Claude Code must follow these rules:\
\pard\pardeftab560\pardirnatural\partightenfactor0
\ls14\ilvl0
\f4\fs18 \cf0 {\listtext	\uc0\u8226 	}
\f1\fs26 Build one feature at a time.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Never modify unrelated files.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Maintain strict TypeScript typing.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Reuse existing components before creating new ones.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Follow the defined folder structure.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Use shadcn/ui components unless a custom component is required.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Validate all inputs with Zod.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Use Supabase Row Level Security (RLS).\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Do not duplicate business logic.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Keep components under ~200 lines where practical.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Keep services focused on a single responsibility.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Write clean, self-documenting code.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Add loading, empty, and error states.\
\ls14\ilvl0
\f4\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 Do not hardcode business rules; read them from shared constants where appropriate.\
\pard\pardeftab560\slleading20\partightenfactor0
\cf0 \
\pard\pardeftab560\sa40\partightenfactor0

