\
\pard\pardeftab560\sa40\partightenfactor0

\f0\b\fs32 \cf0 Neutral Colors\
\pard\pardeftab560\slleading20\partightenfactor0

\f1\b0\fs26 \cf0 Neutral colors should occupy approximately 
\f0\b 80\'9690%
\f1\b0  of the interface.\
They provide structure, readability, and a calm visual hierarchy.\
\
\pard\pardeftab560\sa40\partightenfactor0

\f0\b\fs32 \cf0 Semantic Colors\
\pard\pardeftab560\slleading20\partightenfactor0

\f1\b0\fs26 \cf0 Semantic colors should communicate system status only.\
\pard\pardeftab560\pardirnatural\partightenfactor0
\ls39\ilvl0
\f5\fs18 \cf0 {\listtext	\uc0\u8226 	}
\f1\fs26 Green 
